# Generated at setup time: the local clone of the demo repo and the cosign
# public key copy. Neither belongs in git.
.local/

# Java build output
target/

# Local python venv for the scanner
.venv/
__pycache__/
*.pyc

# Coverage artifacts
.coverage
coverage.xml
htmlcov/
.pytest_cache/

# Credentials and local config. SETUP tells you to export HF_TOKEN, so a .env
# holding it is the likely accident.
.env
.env.*
*.kubeconfig
.local/gitea-credentials

# Model weights and GGUF conversions - multi-GB and not ours to redistribute.
models/
*.gguf
*.safetensors
